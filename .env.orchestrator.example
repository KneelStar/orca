# Orca orchestrator configuration. Copy to .env on the main server.
ORCA_ROLE=orchestrator
ORCA_ADMIN_PASSWORD=
ORCA_SESSION_SECRET=
ORCA_ADMIN_TITLE=Your fleet
ORCA_PUBLIC_TITLE=Your home base
# The default is 0.0.0.0 for network/Tailscale devices. Use 127.0.0.1 for localhost-only access.
ORCA_BIND_IP=0.0.0.0
ORCA_PORT=8000
ORCA_COOKIE_SECURE=false

# Optional: pin a stable release instead of following latest.
# ORCA_IMAGE=ghcr.io/kneelstar/orca:0.2.7
