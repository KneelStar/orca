# Copy to .env. Generate independent random values; never commit the real .env.
ORCA_ROLE=orchestrator
ORCA_HOST=127.0.0.1
ORCA_PORT=8000
ORCA_ADMIN_PASSWORD=
ORCA_SESSION_SECRET=
ORCA_ADMIN_TITLE=Your fleet
ORCA_PUBLIC_TITLE=Your home base
ORCA_COOKIE_SECURE=false
# Client settings (a separate .env on each managed server):
ORCA_CLIENT_NAME=Home server
ORCA_CLIENT_TOKEN=
ORCA_EXECUTION_MODE=local
# Optional: SSH from a Docker client into its POSIX host.
# ORCA_EXECUTION_MODE=ssh
# ORCA_SSH_TARGET=orca@host.docker.internal
# ORCA_SSH_KEY=/run/orca/ssh_key
# ORCA_SSH_KNOWN_HOSTS=/run/orca/known_hosts
# ORCA_SSH_PORT=22
# ORCA_SSH_PYTHON=python3
