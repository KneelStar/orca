# Orca Client configuration. Copy to .env on each managed server.
ORCA_ROLE=client
ORCA_ADMIN_PASSWORD=
ORCA_SESSION_SECRET=
ORCA_CLIENT_TOKEN=
ORCA_CLIENT_NAME=Home server
# The default is 0.0.0.0 for network/Tailscale devices. Use 127.0.0.1 for localhost-only access.
ORCA_BIND_IP=0.0.0.0
ORCA_PORT=8001
ORCA_COOKIE_SECURE=false
ORCA_EXECUTION_MODE=local

# Optional SSH execution from a Docker client:
# ORCA_SSH_TARGET=orca@host.docker.internal
# ORCA_SSH_PORT=22
# ORCA_SSH_PYTHON=python3
# ORCA_SSH_KEY_FILE=/absolute/path/to/private_key
# ORCA_SSH_KNOWN_HOSTS_FILE=/absolute/path/to/known_hosts
